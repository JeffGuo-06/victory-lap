#!/usr/bin/env bash
#
# teams-ringtone — use your own track as a Microsoft Teams ringtone (macOS)
#
# Converts any audio file to the WAV format Teams requires and installs it
# into the Teams "Sounds" folder, where it shows up in
# Settings > Calls > Ringtones. Keeps a local library so you can re-apply
# after a Teams update wipes the folder.
#
# https://github.com/JeffGuo-06/victory-lap

set -euo pipefail

VERSION="0.1.0"

# Teams (new client, com.microsoft.teams2) scans this folder for extra sounds.
SOUNDS_DIR="${TEAMS_RINGTONE_SOUNDS_DIR:-$HOME/Library/Containers/com.microsoft.teams2/Data/Library/Application Support/Microsoft/Teams/Sounds}"
CONTAINER_DIR="$HOME/Library/Containers/com.microsoft.teams2"
LIBRARY_DIR="${TEAMS_RINGTONE_LIBRARY:-$HOME/.teams-ringtone}"

bold()  { printf '\033[1m%s\033[0m\n' "$*"; }
info()  { printf '  %s\n' "$*"; }
warn()  { printf '\033[33mwarning:\033[0m %s\n' "$*" >&2; }
die()   { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<EOF
teams-ringtone $VERSION — custom ringtones for Microsoft Teams (new client)

Usage:
  teams-ringtone replace <audio-file>      Replace the DEFAULT incoming-call
                                           ringtone with your track (macOS)
  teams-ringtone replace <file> <sound>    Replace a specific Teams sound
                                           (see 'cached' for names)
  teams-ringtone restore-original [sound]  Put the stock Teams sound back
  teams-ringtone cached                    List Teams' cached sounds + patch state
  teams-ringtone doctor                    Check your setup
  teams-ringtone help                      Show this help

Legacy Sounds-folder commands (no effect on current macOS Teams; the folder
is only scanned by Teams for Windows — see README):
  add <audio-file> [name] [--no-trim] | list | remove <name> | reapply | open

Before 'replace': open Teams' Settings > Calls > Ringtones once (so Teams
downloads the sounds), then quit Teams fully (Cmd+Q).

Accepts mp3, m4a, aac, wav, aiff, caf — anything ffmpeg can decode.

Tip: Teams rings for ~20s before a call goes to voicemail — only your
track's first ~24s are used.
EOF
}

# Resolve the repo dir even when invoked via a PATH symlink.
resolve_script_dir() {
  local src="${BASH_SOURCE[0]}"
  while [[ -L "$src" ]]; do src="$(readlink "$src")"; done
  cd "$(dirname "$src")" && pwd
}

PATCHER="$(resolve_script_dir)/scripts/patch_cache.py"

cmd_replace() {
  local src="${1:-}" sound="${2:-ring}"
  [[ -n "$src" ]] || die "usage: teams-ringtone replace <audio-file> [sound]"
  [[ -f "$src" ]] || die "file not found: $src"
  command -v ffmpeg >/dev/null || die "ffmpeg is required: brew install ffmpeg"
  command -v python3 >/dev/null || die "python3 is required (install Xcode CLT)"
  if pgrep -xq MSTeams; then
    die "Teams is running — quit it fully first (Cmd+Q or right-click dock icon > Quit)"
  fi
  python3 "$PATCHER" patch "$src" "$sound"
}

cmd_restore_original() {
  if pgrep -xq MSTeams; then
    die "Teams is running — quit it fully first (Cmd+Q)"
  fi
  python3 "$PATCHER" restore "${1:-ring}"
}

cmd_cached() {
  python3 "$PATCHER" status
}

require_teams_container() {
  # Honor an explicit override (used by tests and non-standard setups).
  if [[ -n "${TEAMS_RINGTONE_SOUNDS_DIR:-}" ]]; then
    mkdir -p "$SOUNDS_DIR"
    return
  fi
  if [[ ! -d "$CONTAINER_DIR/Data" ]]; then
    die "Teams data folder not found at:
  $CONTAINER_DIR
Install the new Microsoft Teams and launch it at least once, then re-run this.
(Download: https://www.microsoft.com/en-us/microsoft-teams/download-app)"
  fi
  mkdir -p "$SOUNDS_DIR"
}

sanitize_name() {
  # Keep it filesystem- and dropdown-friendly.
  printf '%s' "$1" | tr -c 'A-Za-z0-9 _.-' '_' | sed -e 's/^ *//' -e 's/ *$//'
}

convert_to_wav() {
  local src="$1" dest="$2"
  # Teams only detects uncompressed WAV; 16-bit little-endian @ 44.1 kHz is the
  # spec that reliably shows up in the dropdown.
  if ! afconvert -f WAVE -d LEI16@44100 "$src" "$dest" 2>/dev/null; then
    die "could not convert '$src'. Is it a valid audio file?"
  fi
}

# Strip leading/trailing silence in place (DAW bounces often pad both ends).
# Works on the 16-bit PCM WAV we just produced; needs python3 (ships with
# Xcode Command Line Tools). Skipped with a warning when unavailable.
trim_silence() {
  local wav="$1"
  if ! command -v python3 >/dev/null; then
    warn "python3 not found — skipping silence trim (install Xcode CLT to enable)"
    return
  fi
  python3 - "$wav" <<'PY' || warn "silence trim failed — keeping audio as exported"
import sys, wave, array

path = sys.argv[1]
THRESH = int(32767 * 0.005)   # ~ -46 dBFS: keeps fades, kills bounce padding
TAIL_PAD_SECS = 0.05

w = wave.open(path, "rb")
ch, fr, n = w.getnchannels(), w.getframerate(), w.getnframes()
assert w.getsampwidth() == 2
samples = array.array("h")
samples.frombytes(w.readframes(n))
w.close()

# Chunked min/max keeps the scan at C speed instead of per-sample Python.
B = 65536

def first_loud():
    for lo in range(0, len(samples), B):
        chunk = samples[lo:lo + B]
        if max(chunk) > THRESH or min(chunk) < -THRESH:
            return next(i for i in range(lo, lo + len(chunk)) if abs(samples[i]) > THRESH)
    return None

def last_loud():
    for hi in range(len(samples), 0, -B):
        lo = max(0, hi - B)
        chunk = samples[lo:hi]
        if max(chunk) > THRESH or min(chunk) < -THRESH:
            return next(i for i in range(hi - 1, lo - 1, -1) if abs(samples[i]) > THRESH)
    return None

first = first_loud()
if first is None:
    print("all-silent", file=sys.stderr)
    sys.exit(1)
last = last_loud()

first_f = first // ch
last_f = min(n, last // ch + 1 + int(TAIL_PAD_SECS * fr))
if first_f == 0 and last_f == n:
    sys.exit(0)

out = samples[first_f * ch : last_f * ch]
ww = wave.open(path, "wb")
ww.setnchannels(ch); ww.setsampwidth(2); ww.setframerate(fr)
ww.writeframes(out.tobytes())
ww.close()
print(f"trimmed {(n - (last_f - first_f)) / fr:.2f}s of silence")
PY
}

cmd_add() {
  local trim=1 args=() a
  for a in "$@"; do
    if [[ "$a" == "--no-trim" ]]; then trim=0; else args+=("$a"); fi
  done
  local src="${args[0]:-}"
  [[ -n "$src" ]] || die "usage: teams-ringtone add <audio-file> [name] [--no-trim]"
  [[ -f "$src" ]] || die "file not found: $src"

  local base name
  base="$(basename "$src")"
  name="$(sanitize_name "${args[1]:-${base%.*}}")"
  [[ -n "$name" ]] || die "could not derive a sound name; pass one explicitly"

  require_teams_container
  mkdir -p "$LIBRARY_DIR"

  local wav="$LIBRARY_DIR/$name.wav"
  bold "Converting '$base' -> $name.wav (16-bit / 44.1 kHz WAV)"
  convert_to_wav "$src" "$wav"
  [[ "$trim" -eq 1 ]] && trim_silence "$wav"

  # Teams rings ~20s by default before voicemail, and loops shorter files.
  local secs
  secs="$(afinfo "$wav" 2>/dev/null | awk '/estimated duration/ {print int($3)}')" || secs=""
  if [[ -n "$secs" && "$secs" -gt 30 ]]; then
    warn "track is ${secs}s long — Teams only rings ~20s by default, so just the intro will be heard; consider exporting the best 10-20s instead"
  fi

  cp "$wav" "$SOUNDS_DIR/$name.wav"
  bold "Installed -> $SOUNDS_DIR/$name.wav"
  echo
  info "Next steps:"
  info "1. Quit Teams completely (Cmd+Q, or right-click dock icon > Quit)"
  info "2. Reopen Teams"
  info "3. Settings > Calls > Ringtones — pick '$name' for incoming calls"
  echo
  info "A copy is kept in $LIBRARY_DIR — run 'teams-ringtone reapply' if a"
  info "Teams update ever resets your sounds."
}

cmd_list() {
  require_teams_container
  bold "Custom sounds installed in Teams:"
  local found=0
  local f
  for f in "$SOUNDS_DIR"/*.wav; do
    [[ -e "$f" ]] || continue
    found=1
    info "$(basename "${f%.wav}")"
  done
  [[ "$found" -eq 1 ]] || info "(none)"
  if [[ -d "$LIBRARY_DIR" ]]; then
    echo
    bold "Library (re-appliable) in $LIBRARY_DIR:"
    for f in "$LIBRARY_DIR"/*.wav; do
      [[ -e "$f" ]] || continue
      info "$(basename "${f%.wav}")"
    done
  fi
}

cmd_remove() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "usage: teams-ringtone remove <name>"
  require_teams_container
  local removed=0
  if [[ -f "$SOUNDS_DIR/$name.wav" ]]; then
    rm "$SOUNDS_DIR/$name.wav"
    info "removed from Teams: $name"
    removed=1
  fi
  if [[ -f "$LIBRARY_DIR/$name.wav" ]]; then
    rm "$LIBRARY_DIR/$name.wav"
    info "removed from library: $name"
    removed=1
  fi
  [[ "$removed" -eq 1 ]] || die "no sound named '$name' (try 'teams-ringtone list')"
  info "Restart Teams for the change to take effect."
}

cmd_reapply() {
  require_teams_container
  local n=0 f
  for f in "$LIBRARY_DIR"/*.wav; do
    [[ -e "$f" ]] || continue
    cp "$f" "$SOUNDS_DIR/"
    info "re-installed: $(basename "${f%.wav}")"
    n=$((n + 1))
  done
  if [[ "$n" -eq 0 ]]; then
    die "library is empty — add a track first with 'teams-ringtone add <file>'"
  fi
  bold "Re-installed $n sound(s). Restart Teams and re-select your ringtone."
}

cmd_open() {
  require_teams_container
  open "$SOUNDS_DIR"
}

cmd_doctor() {
  bold "teams-ringtone doctor"
  if [[ -d "/Applications/Microsoft Teams.app" ]]; then
    info "[ok] Microsoft Teams app found"
  else
    warn "Microsoft Teams not found in /Applications (new client required)"
  fi
  if [[ -d "$CONTAINER_DIR/Data" ]]; then
    info "[ok] Teams data container exists"
  else
    warn "Teams data container missing — launch Teams once first"
  fi
  if [[ -d "$SOUNDS_DIR" ]]; then
    info "[ok] Sounds folder: $SOUNDS_DIR"
  else
    info "[--] Sounds folder will be created on first 'add'"
  fi
  if command -v afconvert >/dev/null; then
    info "[ok] afconvert available (built into macOS)"
  else
    warn "afconvert not found — is this macOS?"
  fi
  if command -v ffmpeg >/dev/null; then
    info "[ok] ffmpeg available (needed for 'replace')"
  else
    warn "ffmpeg not found — 'replace' needs it: brew install ffmpeg"
  fi
  local cache="$HOME/Library/Containers/com.microsoft.teams2/Data/Library/Caches/Microsoft/MSTeams/EBWebView/WV2Profile_tfw/Cache/Cache_Data"
  if [[ -d "$cache" ]]; then
    info "[ok] Teams web cache present (used by 'replace')"
  else
    warn "Teams web cache missing — launch Teams and open Settings > Calls once"
  fi
}

case "${1:-help}" in
  replace)  shift; cmd_replace "$@" ;;
  restore-original) shift; cmd_restore_original "$@" ;;
  cached)   cmd_cached ;;
  add)      shift; cmd_add "$@" ;;
  list)     cmd_list ;;
  remove)   shift; cmd_remove "$@" ;;
  reapply)  cmd_reapply ;;
  open)     cmd_open ;;
  doctor)   cmd_doctor ;;
  version|--version|-v) echo "teams-ringtone $VERSION" ;;
  *) usage ;;
esac
